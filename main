<body>

<h1>🐷 OCR 座標・精度検証テスト</h1>

<div class="controls">
    <input type="file" id="fileInput" accept="image/png, image/jpeg">
    <div id="status-area">
        <span id="statusText" class="status-idle">スクリーンショットを選択してください</span>
    </div>
</div>

<div id="results-container">
    <!-- ここに13箇所の結果が動的に追加されます -->
</div>

<!-- 元画像の描画と切り抜きを確認するためのデバッグエリア -->
<div id="debug-canvas-container" style="display:none;">
    <h2>全エリア切り抜き確認パネル</h2>
    <canvas id="originalCanvas"></canvas>
    <p style="font-size:0.8rem; color:#888;">緑枠: 読み取り範囲（%）</p>
</div>

<script>
/**
 * 1. 座標設定（比率 %）
 * 手持ちの2機種でズレる場合は、ここ（x, y）の値を Safari上でデバッグしながら微調整します。
 */
const cropAreas = [
  { key: 'target_game', label: '対象ゲーム数', x: 53.0, y: 32.8, w: 15.0, h: 4.4 }, // 数字部分
  { key: 'btn_1_1',     label: '1段目:投資',   x: 3.5,  y: 38.0, w: 19.5, h: 7.5 },
  { key: 'btn_1_2',     label: '1段目:②',     x: 27.5, y: 38.0, w: 19.5, h: 7.5 },
  { key: 'btn_1_3',     label: '1段目:リプ',   x: 51.5, y: 38.0, w: 19.5, h: 7.5 },
  { key: 'btn_1_4',     label: '1段目:リプV',  x: 75.5, y: 38.0, w: 19.5, h: 7.5 },
  { key: 'btn_2_1',     label: '2段目:羽根拾', x: 3.5,  y: 52.0, w: 19.5, h: 7.5 },
  { key: 'btn_2_2',     label: '2段目:V入賞',  x: 27.5, y: 52.0, w: 19.5, h: 7.5 },
  { key: 'btn_2_3',     label: '2段目:SP',     x: 51.5, y: 52.0, w: 19.5, h: 7.5 },
  { key: 'btn_2_4',     label: '2段目:SPV',    x: 75.5, y: 52.0, w: 19.5, h: 7.5 },
  { key: 'btn_3_1',     label: '3段目:拾蹴',   x: 3.5,  y: 66.0, w: 19.5, h: 7.5 },
  { key: 'btn_3_2',     label: '3段目:当大',   x: 27.5, y: 66.0, w: 19.5, h: 7.5 },
  { key: 'btn_3_3',     label: '3段目:当中',   x: 51.5, y: 66.0, w: 19.5, h: 7.5 },
  { key: 'btn_3_4',     label: '3段目:当小',   x: 75.5, y: 66.0, w: 19.5, h: 7.5 },
];

/**
 * 2. OCRの設定（数字専用・1行モード）
 */
const ocrParams = {
  tessedit_char_whitelist: '0123456789-', // 数字とハイフンのみ許可
  tessedit_pageseg_mode: Tesseract.PSM.SINGLE_LINE, // 1行として認識
};

// --- グローバル変数 ---
let worker = null; // OCRワーカー
const fileInput = document.getElementById('fileInput');
const statusText = document.getElementById('statusText');
const container = document.getElementById('results-container');
const originalCanvas = document.getElementById('originalCanvas');
const originalCtx = originalCanvas.getContext('2d');

/**
 * 初期化：Tesseractワーカーの作成
 */
async function initOCR() {
    updateStatus('status-processing', 'OCRエンジン起動中...');
    worker = await Tesseract.createWorker('eng');
    await worker.setParameters(ocrParams);
    updateStatus('status-idle', '準備完了（スクショを選択）');
}

/**
 * ファイル選択イベント
 */
fileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file || !worker) return;

    // 前回の結果をクリア
    container.innerHTML = '';
    document.getElementById('debug-canvas-container').style.display = 'none';
    
    updateStatus('status-processing', '画像読み込み中...');

    const reader = new FileReader();
    reader.onload = (event) => {
        const img = new Image();
        img.onload = () => processImage(img);
        img.src = event.target.result;
    };
    reader.readAsDataURL(file);
});

/**
 * メイン処理：切り抜き、前処理、OCR、表示
 */
async function processImage(img) {
    const { width: imgW, height: imgH } = img;
    
    // デバッグ用キャンバスの設定（元画像を描画して枠線を表示）
    originalCanvas.width = imgW;
    originalCanvas.height = imgH;
    originalCtx.drawImage(img, 0, 0);
    document.getElementById('debug-canvas-container').style.display = 'block';

    updateStatus('status-processing', '13箇所の切り抜き & 解析中...');
    const startTime = performance.now();

    // 13箇所を順番に解析（iPhone Safariの負荷を考慮し、非同期で順番に回す）
    for (let i = 0; i < cropAreas.length; i++) {
        const area = cropAreas[i];
        
        // --- 3. 画像の前処理（切り抜き & 白黒化） ---
        const { base64, cropPx } = getProcessedCropBase64(img, area);

        // デバッグキャンバスに緑枠を描画
        originalCtx.strokeStyle = '#00ff00';
        originalCtx.lineWidth = Math.max(2, imgW / 300); // 解像度に合わせて太さを調整
        originalCtx.strokeRect(cropPx.x, cropPx.y, cropPx.w, cropPx.w); // w, w にして正方形に近く描画（デバッグ用）

        // --- 4. OCR実行 ---
        const { data: { text } } = await worker.recognize(base64);

        // --- 5. 結果の表示（人間が確認しやすいUI） ---
        createResultUI(area, base64, text);
    }

    const endTime = performance.now();
    const sec = ((endTime - startTime) / 1000).toFixed(1);
    updateStatus('status-complete', `解析完了 (${sec}秒)`);
}

/**
 * Canvasを使ってグレースケール -> 二値化 -> クロップを行い、Base64を取得する
 */
function getProcessedCropBase64(imgElement, areaPercent) {
  const tempCanvas = document.createElement('canvas');
  const tempCtx = tempCanvas.getContext('2d');

  const imgW = imgElement.width;
  const imgH = imgElement.height;

  // 比率（%）からピクセル座標を計算
  const cropX = (areaPercent.x / 100) * imgW;
  const cropY = (areaPercent.y / 100) * imgH;
  const cropW = (areaPercent.w / 100) * imgW;
  const cropH = (areaPercent.h / 100) * imgH;

  // ワーキングキャンバスのサイズを設定（OCRが認識しやすいよう、少し余白を持つ）
  // ボタンの文字が小さい場合は、ここで2倍に拡大描画すると精度が上がる場合があります。
  const scale = (cropW < 60) ? 2 : 1; // 元が小さい場合は2倍に拡大
  tempCanvas.width = cropW * scale;
  tempCanvas.height = cropH * scale;

  // 拡大描画（ぼやけないようスムージングをオフにする）
  tempCtx.imageSmoothingEnabled = false;
  tempCtx.drawImage(
    imgElement,
    cropX, cropY, cropW, cropH, // 元画像のソース（クロップ領域）
    0, 0, tempCanvas.width, tempCanvas.height // キャンバス全体に拡大描画
  );

  // --- 2つの重要点：グレースケール & 二値化 ---
  const imageData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
  const data = imageData.data;

  // 白文字を認識させるための二値化。
  // 閾値を高めに設定し（200以上）、背景（青・茶・グレー）を真っ黒に、
  // 白い数字だけを 真っ白（255）に残します。
  const threshold = 180; 

  for (let i = 0; i < data.length; i += 4) {
    const r = data[i];
    const g = data[i+1];
    const b = data[i+2];
    
    // グレースケール化
    const gray = 0.299 * r + 0.587 * g + 0.114 * b;
    
    // 二値化：閾値より明るければ白、それ以外は真っ黒
    const finalVal = (gray > threshold) ? 255 : 0;

    data[i] = data[i+1] = data[i+2] = finalVal;
    // data[i+3] (アルファ)は触らない（不透明）
  }

  // 処理したピクセルデータをCanvasに戻す
  tempCtx.putImageData(imageData, 0, 0);

  return {
      base64: tempCanvas.toDataURL('image/png'),
      cropPx: { x: cropX, y: cropY, w: cropW, h: cropH }
  };
}

/**
 * 1項目分の結果UIを作成して追加
 */
function createResultUI(area, base64, recognizedText) {
    const item = document.createElement('div');
    item.className = 'result-item';

    // ラベル（対象ゲーム数、1段目:投資など）
    const labelCell = document.createElement('div');
    labelCell.className = 'label-cell';
    labelCell.innerText = area.label;

    // OCRに渡された白黒画像のプレビュー
    // filter: invert(1) で反転させて表示（人間が見やすいよう数字を黒にする）
    const imageCell = document.createElement('div');
    imageCell.className = 'image-cell';
    const img = new Image();
    img.src = base64;
    img.className = 'crop-preview';
    imageCell.appendChild(img);

    // OCR認識結果
    const ocrCell = document.createElement('div');
    const cleanedText = recognizedText.trim();
    const finalNumber = (cleanedText === '-' || cleanedText === '') ? '0' : cleanedText;

    // 「0」と「-」は特に色を変えて強調
    if (finalNumber === '0') {
        ocrCell.className = 'ocr-cell mismatch'; // 0は要注意として赤系にする（既存ツールで誤読が多かったため）
    } else {
        ocrCell.className = 'ocr-cell match'; // 数字が読めていれば緑系
    }
    
    ocrCell.innerText = finalNumber;

    item.appendChild(labelCell);
    item.appendChild(imageCell);
    item.appendChild(ocrCell);
    container.appendChild(item);
}

/**
 * ステータス表示の更新
 */
function updateStatus(cls, text) {
    statusText.className = cls;
    statusText.innerText = text;
    console.log(`[Status] ${text}`);
}

// ページロード時にOCRを起動
initOCR();

</script>

</body>
</html>
